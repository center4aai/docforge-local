# DocForge Local runtime configuration template
# Recommended primary UX: `docforge-local config` (interactive manager).
# This file remains a supported secondary workflow for CI/manual/advanced setups.

# Required for env-driven workflows: set REPO_AUTODOCS_PROJECT_ROOT to the repository you want to document.
# Note: an explicit CLI/runtime --project-root always has higher precedence.
REPO_AUTODOCS_PROJECT_ROOT=/path/to/your/repository

# Optional path overrides (defaults are shown here)
REPO_AUTODOCS_DOCS_DIR=/path/to/your/repository/.docforge-local/docs
# Canonical multi-input reference paths (path-list; path separator is platform-specific: ':' on Unix, ';' on Windows)
REPO_AUTODOCS_REFERENCE_PATHS=/path/to/ref1:/path/to/ref2
# Deprecated single-path alias (maps to the first explicit reference input):
REPO_AUTODOCS_REFERENCE_DIR=/path/to/your/repository/docs/context/reference
# Deprecated alias of deprecated alias:
# REPO_AUTODOCS_METHODOLOGY_DIR=/path/to/your/repository/docs/context/reference
REPO_AUTODOCS_OUTPUT_DIR=/path/to/your/repository/.docforge-local/docs/generated
# Backward-compatible alias for output_dir:
REPO_AUTODOCS_GENERATED_DOCS_DIR=/path/to/your/repository/.docforge-local/docs/generated
REPO_AUTODOCS_SITE_DIR=/path/to/your/repository/.docforge-local/site

# Optional user-config override
REPO_AUTODOCS_USER_CONFIG_FILE=/path/to/your/user/config.toml

# Optional diagnostics
# false by default; set true to generate debug markdown artifacts.
REPO_AUTODOCS_DEBUG_ARTIFACTS=false
# Generated prose language for deterministic and LLM outputs: en (default) or ru.
# Only explanatory prose is localized; filenames/headings/routes/commands/identifiers stay canonical.
# This task does not expand localization scope beyond that behavior.
REPO_AUTODOCS_GENERATED_TEXT_LANGUAGE=en
REPO_AUTODOCS_USE_REPO_ANALYSIS_DEFAULT_IGNORES=true
REPO_AUTODOCS_USE_REPO_GITIGNORE=true
REPO_AUTODOCS_REPO_ANALYSIS_IGNORE_PATTERNS=tmp/**,notes/*.md
REPO_AUTODOCS_REPO_ANALYSIS_UNIGNORE_PATTERNS=tmp/keep.md
REPO_AUTODOCS_REFERENCE_INCLUDE_README_DEFAULT=true
REPO_AUTODOCS_REFERENCE_INCLUDE_AGENT_INSTRUCTIONS_DEFAULT=true
# Optional default-target pattern overrides (comma or platform path-separator delimited)
REPO_AUTODOCS_REFERENCE_DEFAULT_README_PATTERNS=README.md
REPO_AUTODOCS_REFERENCE_DEFAULT_AGENT_INSTRUCTION_PATTERNS=**/AGENTS.md:**/CLAUDE.md:**/CODEX.md

# LLM mode required settings (only when REPO_AUTODOCS_ENABLE_LLM=true)
REPO_AUTODOCS_ENABLE_LLM=false
REPO_AUTODOCS_MODEL_NAME=gpt-4.1-mini
REPO_AUTODOCS_BASE_URL=https://api.openai.com/v1
REPO_AUTODOCS_TEMPERATURE=0.2

# Optional auth settings (default API key mode is environment variable based)
# keyring package is included in normal installs; backend availability still depends on OS setup.
REPO_AUTODOCS_API_KEY_MODE=env
REPO_AUTODOCS_API_KEY_ENV_VAR=OPENAI_API_KEY
REPO_AUTODOCS_API_KEY_SECRET_NAME=docforge-openai
# In api_key_mode=env, secret deletion is manual: remove the env var from your shell/profile.
OPENAI_API_KEY=your_api_key_here
